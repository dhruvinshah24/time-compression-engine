# ==============================================================================
# Time Compression Engine (TCE) - Root / Shared Configuration
# ==============================================================================

# Database Connection (PostgreSQL async engine)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tce

# Redis / Message Broker (for background task queues / Celery if enabled)
REDIS_URL=redis://localhost:6379/0

# Backend API Service Settings
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=tce-secret-key-development-change-in-production

# Storage Backend
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# Frontend Public API URLs (Consumed by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Feature Toggles
AUTH_ENABLED=false
EXPLAINABILITY_ENABLED=true

# AI / Deep Learning Model Overrides (Optional - defaults to Ultralytics YOLO models)
YOLO_MODEL_PATH=
DINO_MODEL_PATH=
